# =============================================================================
# MẪU biến môi trường. Copy thành .env (đã có trong .gitignore) rồi điền giá trị:
#   Copy-Item .env.example .env
# KHÔNG commit .env. KHÔNG dùng ví có tiền thật.
# =============================================================================

# ----- MQTT (Phase 0+) -----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ----- Bảo mật thiết bị (Phase 2+) -----
# Khóa HMAC-SHA256 dùng chung ESP32 <-> backend: 32 byte dạng hex (64 ký tự).
# Sinh khóa:  python -c "import secrets; print(secrets.token_hex(32))"
# Giá trị này phải TRÙNG HRC_HMAC_KEY_HEX trong iot_code/firmware/include/secrets.h
HRC_HMAC_KEY_HEX=

# ----- Blockchain (Phase 1, 4, 8) -----
LOCAL_RPC_URL=http://127.0.0.1:8545
# RPC backend dùng; để trống = LOCAL_RPC_URL. Phase 8 đặt = SEPOLIA_RPC_URL
CHAIN_RPC_URL=
SEPOLIA_RPC_URL=
# Để trống = tự đọc từ contracts/ignition/deployments/chain-<id>/deployed_addresses.json
CONTRACT_ADDRESS=
ETHERSCAN_API_KEY=
# Private key theo vai trò – CHỈ ví test.
# LOCAL: copy khóa CÔNG KHAI mà `npx hardhat node` in ra:
#   ADMIN = account #0, DEVICE = #1, SUPERVISOR = #2, OPERATOR = #3, AUDITOR = #4 (khớp ignition module)
ADMIN_PRIVATE_KEY=
DEVICE_PRIVATE_KEY=
SUPERVISOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
AUDITOR_PRIVATE_KEY=
# Private key ví deploy trên Sepolia (Hardhat configVariable) – chỉ ví test
SEPOLIA_PRIVATE_KEY=

# ----- Backend (Phase 2+) -----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SQLITE_PATH=backend/data/hrc_log.sqlite3
