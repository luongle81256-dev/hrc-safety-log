# =============================================================================
# HỒ SƠ MẠNG SEPOLIA. Copy thành .env.sepolia (đã .gitignore) rồi điền:
#   Copy-Item .env.sepolia.example .env.sepolia
# Dùng:  $env:HRC_NETWORK = "sepolia"   (PowerShell)  – mọi lệnh hrc-* và script sẽ đọc file này trước .env
# CHỈ dùng ví TEST, không dùng ví có tiền thật. KHÔNG commit, KHÔNG gửi private key qua chat.
# =============================================================================

# RPC Sepolia (Alchemy/Infura miễn phí), dạng https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
SEPOLIA_RPC_URL=
# Private key ví DEPLOY = DEFAULT_ADMIN (cần ~0.02 SepoliaETH cho deploy + cấp quyền)
SEPOLIA_PRIVATE_KEY=
# (Tùy chọn) verify mã nguồn contract trên Etherscan: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Backend dùng RPC nào (mặc định chính SEPOLIA_RPC_URL)
CHAIN_RPC_URL=${SEPOLIA_RPC_URL}
# RPC để dashboard ĐỌC chuỗi từ trình duyệt (có thể dùng RPC công khai, vd https://ethereum-sepolia-rpc.publicnode.com)
DASHBOARD_RPC_URL=${SEPOLIA_RPC_URL}

# Ví DEVICE = ví backend ký anchorLog/reportIncident (cần SepoliaETH trả gas, ~0.0003 ETH/batch).
# Để trống dòng dưới => dùng luôn ví deploy (đơn giản cho demo, nhưng dồn nhiều quyền vào 1 ví)
DEVICE_PRIVATE_KEY=${SEPOLIA_PRIVATE_KEY}

# Địa chỉ nhận vai trò (để trống => dùng địa chỉ ví deploy). SUPERVISOR nên là ví MetaMask dùng bấm "Mở khóa".
SUPERVISOR_ADDRESS=
OPERATOR_ADDRESS=
AUDITOR_ADDRESS=
# (Tùy chọn) private key tương ứng – chỉ cần nếu muốn script demo tự check-in / tự mở khóa / tự ghi kết quả audit
SUPERVISOR_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
AUDITOR_PRIVATE_KEY=

# Script deploy tự điền 2 dòng này sau khi deploy
CONTRACT_ADDRESS=
CHAIN_START_BLOCK=

# DB riêng cho Sepolia (không trộn log local với log testnet)
SQLITE_PATH=backend/data/hrc_log_sepolia.sqlite3
